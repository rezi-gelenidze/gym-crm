# PostgreSQL Database
SPRING_DATASOURCE_USERNAME=admin
SPRING_DATASOURCE_PASSWORD=adminpassword
SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5432/gym
POSTGRES_DB=gym

# Eureka
EUREKA_URI=http://localhost:8761/eureka

# MongoDB
MONGO_INITDB_DATABASE=gym
SPRING_DATA_MONGODB_URI=mongodb://localhost:27017/gym

# ActiveMQ
SPRING_ACTIVEMQ_BROKER_URL=tcp://localhost:61616
SPRING_ACTIVEMQ_USER=admin
SPRING_ACTIVEMQ_PASSWORD=adminpassword

# Authentication
AUTH_MAX_ATTEMPTS=3
AUTH_BLOCK_DURATION=300000
AUTH_JWT_EXPIRATION=36000000
AUTH_JWT_SECRET=SECURE_2048_BIT_QUANTUM_RANDOM_SUPER_DUPER_STRONG_SECRET_KEY